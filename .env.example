# One logical completion, including protocol correction. Never changes the model.
COMPLETION_TIMEOUT_SECONDS=600
COMPLETION_MAX_BYTES=16777216
# 0 disables correction; 1 permits one regeneration within remaining max_tokens.
EMULATED_CORRECTION_ATTEMPTS=1
# Qwen only: exact suffixes for truncated tool JSON; shares the original limits.
# 0 disables continuation; 8 is the default; maximum 16 upstream requests.
EMULATED_CONTINUATION_ATTEMPTS=8
LOG_LEVEL=INFO
LOG_TO_FILE=true
