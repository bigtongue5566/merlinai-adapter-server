# Web is the default. Its official path/header profile overrides the legacy fields below.
MERLIN_TRANSPORT=web
# These three settings apply only when MERLIN_TRANSPORT=extension.
MERLIN_VERSION=merlin-extension-8.2.3
MERLIN_PATH=/arcane/api/v2/extension/chat
MERLIN_ORIGIN=chrome-extension://camppjleccjaphfdbohjdohecfnoikec
